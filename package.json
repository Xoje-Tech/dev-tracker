{
  "name": "dev-tracker",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Dev Tracker — Kanban-style project management with Vue 3 + Express + Prisma",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc && tsc-alias && vite build",
    "start": "node dist/src/server/index.js",
    "cli": "cd cli && node dist/index.js",
    "cli:dev": "cd cli && tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:client:watch": "vitest --config vitest.client.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "db:generate": "node_modules/.bin/prisma generate",
    "db:push": "node_modules/.bin/prisma db push",
    "db:studio": "node_modules/.bin/prisma studio",
    "typecheck": "node_modules/.bin/tsc --noEmit"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "connect-sqlite3": "0.9.16",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "^5.2.1",
    "express-session": "1.19.0",
    "helmet": "8.2.0",
    "morgan": "1.11.0",
    "pinia": "3.0.4",
    "prisma": "6.19.3",
    "vue": "^3.5.39",
    "vue-draggable-plus": "0.6.1",
    "vue-router": "^4.6.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.1",
    "@types/bcryptjs": "3.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/morgan": "1.9.10",
    "@types/node": "26.0.1",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.62.0",
    "@typescript-eslint/parser": "8.62.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.9",
    "@vue/test-utils": "2.4.11",
    "autoprefixer": "10.5.2",
    "eslint": "10.6.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.15",
    "prettier": "3.9.1",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.1",
    "tsc-alias": "1.8.17",
    "tsx": "4.22.4",
    "typescript": "^5.9.3",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "vue-tsc": "3.3.5"
  }
}
