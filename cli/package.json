{
  "name": "dev-tracker-cli",
  "version": "1.8.1",
  "private": true,
  "type": "commonjs",
  "description": "Command-line interface for dev-tracker — wraps the REST API so agents and humans can drive the app from the terminal.",
  "bin": {
    "dt": "./dist/index.js"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "targets": [
      "node18-linux-x64",
      "node18-macos-x64",
      "node18-macos-arm64"
    ],
    "outputPath": "binaries"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "package": "pnpm run build && bash scripts/package.sh"
  },
  "dependencies": {
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "pkg": "^5.8.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
