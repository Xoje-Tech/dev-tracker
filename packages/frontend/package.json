    "vue-draggable-plus": "0.6.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "26.0.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.9",
    "@vue/test-utils": "2.4.11",
    "autoprefixer": "10.5.2",
    "jsdom": "29.1.1",
    "postcss": "8.5.15",
    "tailwindcss": "4.3.1",
    "typescript": "^5.9.3",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "vue-tsc": "3.3.5"
  }
