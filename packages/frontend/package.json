{
  "name": "@dev-tracker/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dev Tracker frontend — Vue 3 + Vite + Tailwind CSS 4 + Pinia",
  "scripts": {
    "dev": "vite",
