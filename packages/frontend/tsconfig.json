{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./src/client",
    "composite": false,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node", "vitest/globals"],
    "paths": {
      "@client/auth/*": ["./modules/auth/*"],
      "@client/board/*": ["./modules/board/*"],
      "@client/projects/*": ["./modules/projects/*"],
      "@client/shared/*": ["./modules/shared/*"],
      "@client/tags/*": ["./modules/tags/*"]
    }
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.vue"],
  "exclude": ["node_modules", "dist"]
}