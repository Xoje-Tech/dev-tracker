{
  "name": "@dev-tracker/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dev Tracker backend — Express 5 + Prisma 6 + SQLite",
  "main": "./dist/server/index.js",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "connect-sqlite3": "0.9.16",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "^5.2.1",
    "express-session": "1.19.0",
    "helmet": "8.2.0",
    "morgan": "1.11.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/morgan": "1.9.10",
    "@types/node": "26.0.1",
    "@types/supertest": "7.2.0",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "tsx": "4.22.4",
    "typescript": "^5.9.3",
    "vitest": "4.1.9"
  }
}
